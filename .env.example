# Copier vers .env et adapter (ne pas commiter .env)

# Sécurité (obligatoire en production)
JWT_SECRET=changez-moi-long-et-aleatoire
POSTGRES_PASSWORD=changez-moi
DB_PASSWORD=changez-moi
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi

# Métadonnées vidéo
TMDB_API_KEY=

# Auto-download interne StreamMake
ENABLE_AUTO_DOWNLOAD=false

# Client torrent : transmission | qbittorrent | deluge | rtorrent
TORRENT_CLIENT_TYPE=transmission

# Suite *arr (uniquement si docker compose --profile arr up)
# PROWLARR_URL=http://prowlarr:9696
# RADARR_URL=http://radarr:7878
# SONARR_URL=http://sonarr:8989

# Webhooks Radarr/Sonarr → backend (obligatoire pour accepter les POST /api/webhooks/*)
WEBHOOK_SECRET=changez-moi-long-aleatoire
# URL affichée dans l’admin pour copier-coller (sans /api)
PUBLIC_WEBHOOK_BASE_URL=https://stream.example.com
